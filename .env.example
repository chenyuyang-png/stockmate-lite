# Stockmate Lite 環境變數範例
# 複製成 .env.local 並填入你的值

# Lite 版頂部 banner 連到 Pro 版的網址（必填，給 LiteBanner / TopNav / /ai 頁用）
NEXT_PUBLIC_PRO_URL=https://stockmate-ai-ashen.vercel.app

# 品牌名（可選，預設 "Stockmate"）
NEXT_PUBLIC_BRAND_NAME=Stockmate Lite

# ⚠️ Lite 版「不要」設這些：
# ANTHROPIC_API_KEY=...     ← Lite 不呼叫 Claude
# CLERK_PUBLISHABLE_KEY=... ← Clerk 已被 shim
# ECPAY_MERCHANT_ID=...     ← 沒有金流
